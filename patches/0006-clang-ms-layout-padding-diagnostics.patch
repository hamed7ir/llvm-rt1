diff --git a/clang/test/CodeGenCXX/warn-padded-microsoft.cpp b/clang/test/CodeGenCXX/warn-padded-microsoft.cpp
new file mode 100644
index 000000000..ba430a0aa
--- /dev/null
+++ b/clang/test/CodeGenCXX/warn-padded-microsoft.cpp
@@ -0,0 +1,107 @@
+// Padding diagnostics must fire under the *Microsoft* record layout builder,
+// not only the Itanium one.  Before this was wired up (clang 18/19/20)
+// MicrosoftRecordLayoutBuilder contained no Diag() call at all, so -Wpadded and
+// -Wpadded-bitfield were silently dead on every *-windows-msvc target.
+//
+// The shapes below are the historical victims from a real ARM32 Windows port
+// (SpiderMonkey's PoolHeader::Header and VFPRegister): a `bool` bitfield wedged
+// between `unsigned` bitfields.  MSVC gives the `bool` its own allocation unit,
+// while the Itanium ABI packs it in place -- so the record silently grows and
+// nothing warned.
+
+// 1. Both groups on: every diagnostic below fires.
+// RUN: %clang_cc1 -triple thumbv7-unknown-windows-msvc -emit-llvm-only \
+// RUN:     -Wpadded -Wpadded-bitfield -verify=ms,msbf %s
+
+// 1b. Same numbers under x86_64: this is an ABI-wide gap, not an ARM one.
+// RUN: %clang_cc1 -triple x86_64-pc-windows-msvc -emit-llvm-only \
+// RUN:     -Wpadded -Wpadded-bitfield -verify=ms,msbf %s
+
+// 2. -Wpadded-bitfield alone enables only the bit-field subgroup.
+// RUN: %clang_cc1 -triple thumbv7-unknown-windows-msvc -emit-llvm-only \
+// RUN:     -Wpadded-bitfield -verify=msbf %s
+
+// 3. Both are DefaultIgnore: a build without the flags is unchanged.
+// RUN: %clang_cc1 -triple thumbv7-unknown-windows-msvc -emit-llvm-only \
+// RUN:     -verify=quiet %s
+
+// 4. Itanium behaviour is untouched by this change.
+// RUN: %clang_cc1 -triple thumbv7-unknown-linux-gnueabihf -emit-llvm-only \
+// RUN:     -Wpadded -Wpadded-bitfield -verify=itanium %s
+
+// quiet-no-diagnostics
+
+typedef unsigned int u32;
+
+// MicrosoftRecordLayoutBuilder::layoutBitField + finalizeLayout.
+// MS: the `bool` starts a fresh allocation unit, so `size` is padded out and
+// `ONES` cannot rejoin it -- sizeof grows 4 -> 12.  Itanium: no padding at all.
+struct HeaderPre { // ms-warning {{padding size of 'HeaderPre' with 2 bytes to alignment boundary}}
+  u32 size : 15;
+  bool isNatural : 1; // msbf-warning {{padding struct 'HeaderPre' with 17 bits to align 'isNatural'}}
+  u32 ONES : 16;      // msbf-warning {{padding struct 'HeaderPre' with 31 bits to align 'ONES'}}
+};
+
+enum RegTypePre { Single_p = 0x0, Double_p = 0x1, UInt_p = 0x2, Int_p = 0x3 };
+
+struct VFPPre { // ms-warning {{padding size of 'VFPPre' with 30 bits to alignment boundary}} itanium-warning {{padding size of 'VFPPre' with 23 bits to alignment boundary}}
+  RegTypePre kind : 2;
+  u32 code_ : 5;
+  bool _isInvalid : 1; // msbf-warning {{padding struct 'VFPPre' with 25 bits to align '_isInvalid'}}
+  bool _isMissing : 1;
+};
+
+// The fixed forms: spelling every bit-field `u32` makes the MS diagnostics go
+// away, which is the whole point of the warning existing.
+struct HeaderPost {
+  u32 size : 15;
+  u32 isNatural : 1;
+  u32 ONES : 16;
+};
+
+enum RegTypePost : u32 { Single_q = 0, Double_q = 1, UInt_q = 2, Int_q = 3 };
+
+struct VFPPost { // ms-warning {{padding size of 'VFPPost' with 23 bits to alignment boundary}} itanium-warning {{padding size of 'VFPPost' with 23 bits to alignment boundary}}
+  RegTypePost kind : 2;
+  u32 code_ : 5;
+  u32 _isInvalid : 1;
+  u32 _isMissing : 1;
+};
+
+// MicrosoftRecordLayoutBuilder::layoutField -- a non-bit-field after a
+// bit-field.  This is warn_padded_struct_field, i.e. -Wpadded and NOT
+// -Wpadded-bitfield, which is what makes RUN line 2 discriminating.
+struct MixedField {
+  u32 a : 3;
+  u32 b; // ms-warning {{padding struct 'MixedField' with 29 bits to align 'b'}} itanium-warning {{padding struct 'MixedField' with 29 bits to align 'b'}}
+};
+
+// MicrosoftRecordLayoutBuilder::layoutZeroWidthBitField.
+struct ZeroWidth { // ms-warning {{padding size of 'ZeroWidth' with 29 bits to alignment boundary}} itanium-warning {{padding size of 'ZeroWidth' with 29 bits to alignment boundary}}
+  u32 a : 3;
+  u32 : 0; // msbf-warning {{padding struct 'ZeroWidth' with 29 bits to align anonymous bit-field}} itanium-warning {{padding struct 'ZeroWidth' with 29 bits to align anonymous bit-field}}
+  u32 c : 3;
+};
+
+// Anonymous non-zero-width bit-field: warn_padded_struct_anon_bitfield.
+struct AnonBits { // ms-warning {{padding size of 'AnonBits' with 31 bits to alignment boundary}} itanium-warning {{padding size of 'AnonBits' with 28 bits to alignment boundary}}
+  u32 a : 3;
+  bool : 1; // msbf-warning {{padding struct 'AnonBits' with 29 bits to align anonymous bit-field}}
+};
+
+// Negative control: no padding under either ABI, so no diagnostic under any of
+// the RUN lines.  If the new call sites ever over-fire, this goes red.
+struct CleanFour {
+  u32 a : 15;
+  u32 b : 1;
+  u32 c : 16;
+};
+
+// Positive control for the reporting mechanism itself: plain trailing padding,
+// identical under both ABIs.
+struct CtlSeventeen { u32 a; u32 b; u32 c; u32 d; unsigned char e; }; // ms-warning {{padding size of 'CtlSeventeen' with 3 bytes to alignment boundary}} itanium-warning {{padding size of 'CtlSeventeen' with 3 bytes to alignment boundary}}
+
+// The warnings are emitted when the layout of the structs is computed, so we
+// have to use them.
+void use(HeaderPre, VFPPre, HeaderPost, VFPPost, MixedField, ZeroWidth,
+         AnonBits, CleanFour, CtlSeventeen) {}
