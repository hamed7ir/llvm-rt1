+; struct S { int x; };
+; void foo(int n);
+; 
+; void simple_except() {
+;   struct S o;
+;   __try {
+;     foo(o.x);
+;   } __except((foo(o.x), 1)) {
+;     foo(o.x);
+;   }
+; }
+; 
+; void stack_realign() {
+;   struct S __declspec(align(32)) o;
+;   __try {
+;     foo(o.x);
+;   } __except((foo(o.x), 1)) {
+;     foo(o.x);
+;   }
+; }
+; 
+; void vla_present(int n) {
