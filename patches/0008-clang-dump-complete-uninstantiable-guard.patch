From 7653a13d8d28189c7cef1401b934ec30d98ea353 Mon Sep 17 00:00:00 2001
From: hamed7ir <hamedghorbani17@live.com>
Date: Sun, 9 Aug 2026 03:26:35 -0700
Subject: [PATCH] [clang] Don't force a layout for records that cannot be laid
 out

VERBATIM backport of upstream e4882d83d77f ("[clang][AST] Fix crash on
'-fdump-record-layouts-complete'", clang/lib/AST/Decl.cpp, 2024-03-04).
First shipped in LLVM 19; never backported to the 18.x branch.  Verified
present on release/22.x, release/23.x and main (2026-08-09).

-fdump-record-layouts-complete forces ASTContext::getASTRecordLayout()
on every record whose definition is completed.  Two disjoint classes of
record reach completeDefinition() but cannot be laid out:

  * a record in a dependent context -- a dependent field type reaches
    llvm_unreachable("Should not see dependent types") in
    ASTContext::getTypeInfoImpl, and a dependent base reaches an
    unchecked getAsCXXRecordDecl() in
    MicrosoftRecordLayoutBuilder::layoutNonVirtualBases;

  * a record Sema has marked invalid -- getASTRecordLayout() on a decl
    with no definition dereferences null.

getASTRecordLayout() documents both preconditions, but as asserts, so in
an assertions-off build they are absent.  The llvm_unreachable is
compiled to __builtin_unreachable when LLVM_UNREACHABLE_OPTIMIZE is ON:
the observable is therefore nondeterministic -- usually SIGSEGV, and on
some runs a fabricated layout printed for a dependent record.

The code change and both upstream test files (dump-complete.cpp,
dump-complete-invalid.cpp) are taken verbatim, including the five-line
explanatory comment above the guard.

Two rt1-authored tests are added alongside them, and the reason is
MEASURED rather than stylistic: upstream's dump-complete-invalid.cpp
exercises an invalid *base class*, and on 18.1.8 that case does NOT
fault (rc=0).  On this branch it therefore does not arm the
!isInvalidDecl() half of the guard at all.  An invalid *field* does
fault, so dump-complete-invalid-field.cpp supplies that must-fail
control; dump-complete-uninstantiable.cpp covers six distinct dependent
shapes across both an MS and an Itanium triple.

Armed floor, MEASURED 2026-08-09 -- stock 18.1.8 SIGSEGVs on 5 of the 6
test/triple combinations (the sixth being upstream's own invalid test,
per above); clang 22.1.8, which carries this guard, returns 0 on all of
them.

Relevant to rt1 because it is the fault that killed 177 of 185 corpus
TUs in the T1 layout oracle's second pass -- anything reaching
<type_traits> hits std::is_integral, a class template with a dependent
base, before it reaches its own code.  The flag is -cc1-only and
unreachable from a driver command line, so it cannot bite a production
build; under working rule 12 that bounds severity but does not discharge
the fix.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 clang/lib/AST/Decl.cpp                        |  8 ++-
 .../Layout/dump-complete-invalid-field.cpp    | 24 ++++++++
 clang/test/Layout/dump-complete-invalid.cpp   |  6 ++
 .../Layout/dump-complete-uninstantiable.cpp   | 31 ++++++++++
 clang/test/Layout/dump-complete.cpp           | 57 ++++++++++++++++++-
 5 files changed, 124 insertions(+), 2 deletions(-)
 create mode 100644 clang/test/Layout/dump-complete-invalid-field.cpp
 create mode 100644 clang/test/Layout/dump-complete-invalid.cpp
 create mode 100644 clang/test/Layout/dump-complete-uninstantiable.cpp

diff --git a/clang/lib/AST/Decl.cpp b/clang/lib/AST/Decl.cpp
index 1ee33fd75..4605b92e4 100644
--- a/clang/lib/AST/Decl.cpp
+++ b/clang/lib/AST/Decl.cpp
@@ -5029,7 +5029,13 @@ void RecordDecl::completeDefinition() {
 
   // Layouts are dumped when computed, so if we are dumping for all complete
   // types, we need to force usage to get types that wouldn't be used elsewhere.
-  if (Ctx.getLangOpts().DumpRecordLayoutsComplete)
+  //
+  // If the type is dependent, then we can't compute its layout because there
+  // is no way for us to know the size or alignment of a dependent type. Also
+  // ignore declarations marked as invalid since 'getASTRecordLayout()' asserts
+  // on that.
+  if (Ctx.getLangOpts().DumpRecordLayoutsComplete && !isDependentType() &&
+      !isInvalidDecl())
     (void)Ctx.getASTRecordLayout(this);
 }
 
diff --git a/clang/test/Layout/dump-complete-invalid-field.cpp b/clang/test/Layout/dump-complete-invalid-field.cpp
new file mode 100644
index 000000000..a398bb33d
--- /dev/null
+++ b/clang/test/Layout/dump-complete-invalid-field.cpp
@@ -0,0 +1,24 @@
+// RUN: %clang_cc1 -triple thumbv7-unknown-windows-msvc -fsyntax-only -verify \
+// RUN:     -fdump-record-layouts-complete %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -fsyntax-only -verify \
+// RUN:     -fdump-record-layouts-complete %s
+
+// rt1 addition, NOT part of upstream e4882d83d77f.  Upstream's own
+// dump-complete-invalid.cpp exercises an invalid *base class*, and MEASURED on
+// clang 18.1.8 that case does not fault -- so on the 18.x branch it does not
+// arm the !isInvalidDecl() half of the guard at all.  An invalid *field* does
+// fault (SIGSEGV, both triples), so this file is what gives that half a
+// must-fail control here.
+
+struct Fwd; // expected-note {{forward declaration of 'Fwd'}}
+
+struct NoLayoutIncomplete {
+  Fwd f; // expected-error {{field has incomplete type 'Fwd'}}
+};
+
+struct NoLayoutSelf { // expected-note {{definition of 'NoLayoutSelf' is not complete until the closing '}'}}
+  NoLayoutSelf s;     // expected-error {{field has incomplete type 'NoLayoutSelf'}}
+  int x;
+};
+
+struct Plain { int a; };
diff --git a/clang/test/Layout/dump-complete-invalid.cpp b/clang/test/Layout/dump-complete-invalid.cpp
new file mode 100644
index 000000000..d3ec1b382
--- /dev/null
+++ b/clang/test/Layout/dump-complete-invalid.cpp
@@ -0,0 +1,6 @@
+// RUN: %clang_cc1 -verify -fsyntax-only -fdump-record-layouts-complete %s
+
+struct Incomplete; // expected-note {{forward declaration}}
+
+// Check we don't crash on trying to print out an invalid declaration.
+struct Invalid : Incomplete {}; // expected-error {{base class has incomplete type}}
diff --git a/clang/test/Layout/dump-complete-uninstantiable.cpp b/clang/test/Layout/dump-complete-uninstantiable.cpp
new file mode 100644
index 000000000..f6467c899
--- /dev/null
+++ b/clang/test/Layout/dump-complete-uninstantiable.cpp
@@ -0,0 +1,31 @@
+// RUN: %clang_cc1 -triple thumbv7-unknown-windows-msvc -emit-llvm-only \
+// RUN:     -fdump-record-layouts-complete %s | FileCheck %s --implicit-check-not=NoLayout
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -emit-llvm-only \
+// RUN:     -fdump-record-layouts-complete %s | FileCheck %s --implicit-check-not=NoLayout
+
+// -fdump-record-layouts-complete forces a layout for every record whose
+// definition is completed.  A record that cannot be laid out -- one in a
+// dependent context, or one Sema has already marked invalid -- must be skipped
+// rather than forced.  Without the guard in RecordDecl::completeDefinition()
+// each of the records below reaches ASTContext::getASTRecordLayout() and the
+// compiler faults (assertions are off in a release build, so the asserts that
+// document the precondition are not present).
+
+// --- dependent: each of these exercises a different downstream fault ---
+template <typename T> struct NoLayoutField { T t; };        // dependent field type
+template <typename T> struct NoLayoutBase : T { int x; };   // dependent base
+template <typename T> struct NoLayoutName { typename T::type t; };
+template <typename T> struct NoLayoutBits { T t : 3; };     // dependent bit-field width
+template <int N> struct NoLayoutArray { char a[N]; };       // dependent array bound
+template <typename T> struct NoLayoutOuter {                // non-dependent record,
+  struct Inner { int x; };                                  // dependent *context*
+};
+
+// --- an instantiation of a dependent pattern is not itself dependent ---
+template <typename T> struct Live { T t; };
+template struct Live<int>;
+
+struct Plain { int a; };
+
+// CHECK:      0 | struct Live<int>
+// CHECK:      0 | struct Plain
diff --git a/clang/test/Layout/dump-complete.cpp b/clang/test/Layout/dump-complete.cpp
index 9ccbf477c..728f133a0 100644
--- a/clang/test/Layout/dump-complete.cpp
+++ b/clang/test/Layout/dump-complete.cpp
@@ -1,4 +1,4 @@
-// RUN: %clang_cc1 -emit-llvm-only -fdump-record-layouts-complete %s | FileCheck %s
+// RUN: %clang_cc1 -fsyntax-only -fdump-record-layouts-complete %s | FileCheck %s
 
 struct a {
   int x;
@@ -12,7 +12,62 @@ class c {};
 
 class d;
 
+template <typename>
+struct s {
+  int x;
+};
+
+template <typename T>
+struct ts {
+  T x;
+};
+
+template <>
+struct ts<void> {
+  float f;
+};
+
+void f() {
+  ts<int> a;
+  ts<double> b;
+  ts<void> c;
+}
+
+namespace gh83671 {
+template <class _Tp, _Tp __v>
+struct integral_constant {
+  static constexpr const _Tp value = __v;
+  typedef integral_constant type;
+};
+
+template <bool _Val>
+using _BoolConstant = integral_constant<bool, _Val>;
+
+template <class _Tp, class _Up>
+struct is_same : _BoolConstant<__is_same(_Tp, _Up)> {};
+
+template < class _Tp >
+class numeric_limits {};
+
+template < class _Tp >
+class numeric_limits< const _Tp > : public numeric_limits< _Tp > {};
+}
+
+namespace gh83684 {
+template <class Pointer>
+struct AllocationResult {
+  Pointer ptr = nullptr;
+  int count = 0;
+};
+}
+
 // CHECK:          0 | struct a
 // CHECK:          0 | struct b
 // CHECK:          0 | class c
+// CHECK:          0 | struct ts<void>
+// CHECK-NEXT:     0 |   float
+// CHECK:          0 | struct ts<int>
+// CHECK:          0 | struct ts<double>
 // CHECK-NOT:      0 | class d
+// CHECK-NOT:      0 | struct s
+// CHECK-NOT:      0 | struct AllocationResult
-- 
2.53.0.windows.3

