rt1 patch 0003 --- [ARM] Model the forwarded argument registers of a musttail vararg forwarder
                    (+ the two review fixes folded in)

Upstream commits in the rt1 tree: a1f390894, 3afb49879.

SCOPE --- read this before assuming "Windows ARM32" means "MSVC".

  The affected path is selected by MCAsmInfo::usesWindowsCFI(), which is true for
  BOTH ARM COFF asm infos:

      ARMCOFFMCAsmInfoMicrosoft   ->  thumbv7-*-windows-msvc
      ARMCOFFMCAsmInfoGNU         ->  thumbv7-*-windows-gnu      (MinGW ARM32)

  ARMCOFFMCAsmInfoGNU sets ExceptionsType = WinEH, so a MinGW ARM32 target takes
  the same WinEH path and is inside this patch's blast radius. Descriptions that
  say only "Windows ARM32" are routinely read as "MSVC only"; that reading is
  wrong for this patch, and equally wrong for patch 0001, whose trigger
  (ARMSubtarget::splitFramePointerPush) is gated on the same usesWindowsCFI().

  rt1 validates on the MSVC target only --- no MinGW ARM32 consumer exists here
  to validate against. The MinGW target is stated as in-scope-by-construction,
  NOT as tested.

diff --git a/llvm/lib/Target/ARM/ARMISelLowering.cpp b/llvm/lib/Target/ARM/ARMISelLowering.cpp
index 23852cf49..44dc06f59 100644
--- a/llvm/lib/Target/ARM/ARMISelLowering.cpp
+++ b/llvm/lib/Target/ARM/ARMISelLowering.cpp
@@ -2474,6 +2474,20 @@ ARMTargetLowering::LowerCall(TargetLowering::CallLoweringInfo &CLI,
   RegsToPassVector RegsToPass;
   SmallVector<SDValue, 8> MemOpChains;
 
+  // A musttail call in a variadic function has to receive the caller's unnamed
+  // register arguments unchanged, so pass on the registers that
+  // LowerFormalArguments recorded as forwarded.  They are disjoint from the
+  // named arguments handled below: musttail requires the callee's prototype to
+  // match the caller's, and the forwarded set was computed from the registers
+  // those named arguments had already consumed.
+  if (isVarArg && CLI.CB && CLI.CB->isMustTailCall()) {
+    const auto &Forwards = AFI->getForwardedMustTailRegParms();
+    for (const ForwardedRegister &F : Forwards) {
+      SDValue Val = DAG.getCopyFromReg(Chain, dl, F.VReg, F.VT);
+      RegsToPass.push_back(std::make_pair(F.PReg, Val));
+    }
+  }
+
   // During a tail call, stores to the argument area must happen after all of
   // the function's incoming arguments have been loaded because they may alias.
   // This is done by folding in a TokenFactor from LowerFormalArguments, but
@@ -4679,6 +4693,37 @@ SDValue ARMTargetLowering::LowerFormalArguments(
     }
   }
 
+  // If this variadic function forwards its arguments with a musttail call, the
+  // unnamed arguments that arrived in registers have to be modelled as live so
+  // that the register allocator does not use one of them as scratch and so that
+  // they are still intact at the tail call.  This must run after the va_list
+  // save area above, which consumes the same registers, but unlike that area it
+  // needs no stack object of its own -- so it is deliberately *not* predicated
+  // on hasVAStart(): a forwarding thunk never calls va_start.
+  if (isVarArg && MFI.hasMustTailInVarArgFunc()) {
+    // getRemainingRegParmsForType() walks the assign function until an argument
+    // lands in memory, so the convention must have a stack fallback.  GHC and
+    // the Windows CFGuard check stub assign to registers only and would run off
+    // the end of their tables; getEffectiveCallingConv() passes both through
+    // unchanged.  Neither supports variadic arguments, so there is nothing to
+    // forward for them, and skipping keeps a shape that compiles today from
+    // becoming a backend abort.
+    CallingConv::ID EffCC = getEffectiveCallingConv(CallConv, isVarArg);
+    if (EffCC != CallingConv::GHC && EffCC != CallingConv::CFGuard_Check) {
+      // For the conventions that remain, only the core registers can hold an
+      // unnamed argument: getEffectiveCallingConv() degrades every VFP
+      // convention to CallingConv::ARM_AAPCS when isVarArg is set, so no
+      // floating-point register is part of the variadic argument window.
+      SmallVector<MVT, 1> RegParmTypes;
+      RegParmTypes.push_back(MVT::i32);
+      // Compute the set of forwarded registers. The rest are scratch.
+      SmallVectorImpl<ForwardedRegister> &Forwards =
+          AFI->getForwardedMustTailRegParms();
+      CCInfo.analyzeMustTailForwardedRegisters(
+          Forwards, RegParmTypes, CCAssignFnForCall(CallConv, isVarArg));
+    }
+  }
+
   unsigned StackArgSize = CCInfo.getStackSize();
   bool TailCallOpt = MF.getTarget().Options.GuaranteedTailCallOpt;
   if (canGuaranteeTCO(CallConv, TailCallOpt)) {
diff --git a/llvm/lib/Target/ARM/ARMMachineFunctionInfo.h b/llvm/lib/Target/ARM/ARMMachineFunctionInfo.h
