+# A Q register is mappable, so this variable keeps its location:
+#      KEPT:   VarName: qreg
+# KEPT-NEXT: }
+# KEPT-NEXT: DefRangeRegisterSym {
+# KEPT-NEXT:   Kind: S_DEFRANGE_REGISTER (0x1141)
+# KEPT-NEXT:   Register: ARM_NQ1 (0x191)
+#
+# The D-pair variable survives with its name and type, but no location:
+#      DROPPED:   Flags [ (0x100)
+# DROPPED-NEXT:     IsOptimizedOut (0x100)
+# DROPPED-NEXT:   ]
+# DROPPED-NEXT:   VarName: dpair
+#
+# Nothing may name the tuple, nor silently substitute one half of it -- that
+# would put the debugger's idea of the variable in the wrong place, which is
+# worse than having no location at all.  No other variable here uses D1 or D2,
+# so neither name can appear for any legitimate reason.
