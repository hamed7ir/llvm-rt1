+// REQUIRES: arm
+// RUN: llvm-mc -filetype=obj -triple=thumbv7-windows %s -o %t.obj
+// RUN: lld-link -entry:main -subsystem:console %t.obj -out:%t.exe -verbose 2>&1 | FileCheck -check-prefix=VERBOSE %s
+// RUN: llvm-objdump --no-print-imm-hex -d %t.exe --start-address=0x401000 --stop-address=0x401008 | FileCheck --check-prefix=MAIN %s
+
+// The thunk margin grows per relocation type. The region after b24_target is
+// arm-thumb-thunks-multipass.s: its BRANCH20T relocations go out of range after
+// the first pass, so a second pass widens BRANCH20T's margin to 200 KB. That
+// must not widen the margin of other types. main's two b.w (BRANCH24T) reach
+// b24_target and func01 16 MB - 150 KB and 16 MB - 144 KB away: in range,
+// outside the 100 KB margin, inside a 200 KB one, and nothing is ever inserted
+// between them and their targets -- so both stay direct branches. Before, one
+// shared margin doubled for every type and both were thunked (30 thunks).
+
+// VERBOSE: Added 28 thunks with margin 204800 in 2 passes
+
+// MAIN: 401000: {{.*}}b.w 0x13db7fa <.text+0xfda7fa>
+// MAIN-NEXT: 401004: {{.*}}b.w 0x13dd000 <.text+0xfdc000>
+
+    .syntax unified
+    .globl main
+    .text
+    .def main; .scl 2; .type 32; .endef
+main:
+    b.w b24_target
+    b func01
+    bx lr
+    .section .text$0a, "xr"
+    .space 0x1000000 - 150*1024 - 16
+    .section .text$0b, "xr"
+    .def b24_target; .scl 2; .type 32; .endef
+    .globl b24_target
+b24_target:
+    bx lr
+
+.irp i, 01, 02, 03, 04, 05, 06, 07, 08, 09, 10, 11, 12, 13, 14, 15, 16, 17, 18
+    .section .text$1\i\()a, "xr"
+    .balign 8192
+func\i:
+    bne far_func\i
+    bne func_within_margin\i
+    .space 8192 - 8 - 4
+
+    .section .text$1\i\()b, "xr"
+    .balign 8192
+align\i:
+    nop
+.endr
+
+    .section .text$999, "xr"
+tail:
+    .space 0x100000 - 100*1024 - 18*8192*2
+.irp i, 01, 02, 03, 04, 05, 06, 07, 08, 09, 10, 11, 12, 13, 14, 15, 16, 17, 18
+func_within_margin\i:
+    nop
+.endr
+    .space 0x100000
+.irp i, 01, 02, 03, 04, 05, 06, 07, 08, 09, 10, 11, 12, 13, 14, 15, 16, 17, 18
+far_func\i:
+    nop
+.endr
+    bx lr
