+# RUN: llc %s -mtriple=thumbv7-unknown-windows-msvc -filetype=obj -o %t --start-after=unpack-mi-bundles
+# RUN: llvm-readobj --codeview %t | FileCheck %s --check-prefix=KEPT
+# RUN: llvm-readobj --codeview %t | FileCheck %s --check-prefix=DROPPED
+# RUN: llvm-readobj --codeview %t | FileCheck %s --check-prefix=NOPAIR
