--- /dev/null
+++ b/llvm/test/CodeGen/ARM/addressofreturnaddress.ll
@@ -0,0 +1,94 @@
+; RUN: llc -O2 -mtriple=thumbv7-pc-windows-msvc < %s | FileCheck %s --check-prefixes=CHECK,O2W
+; RUN: llc -O0 -mtriple=thumbv7-pc-windows-msvc < %s | FileCheck %s --check-prefixes=CHECK,O0W
+; RUN: llc -O2 -mtriple=thumbv7-linux-gnueabihf < %s | FileCheck %s --check-prefixes=CHECK,ELF
+
+; llvm.addressofreturnaddress (MSVC's _AddressOfReturnAddress) is the address
+; of the stack slot that holds the return address: the LR half of the
+; {frame pointer, LR} frame record, at frame pointer + 4. Without a lowering
+; the ARM backend crashed. LR must be spilled even in a leaf function, or the
+; frame pointer + 4 is SP at entry, where no return address is stored.
+; Each function stores the result through a global, so it cannot be dropped.
+
+@r = global ptr null
+
+declare ptr @llvm.addressofreturnaddress.p0()
+declare void @callee()
+
+; A leaf: LR is saved only because its address is taken.
+define void @leaf() noinline {
+; CHECK-LABEL: leaf:
+; O2W:         push.w {r11, lr}
+; O2W-NEXT:    .seh_save_regs_w {r11, lr}
+; O2W-NEXT:    mov r11, sp
+; O2W:         add.w r0, r11, #4
+; O0W:         push.w {r11, lr}
+; O0W-NEXT:    .seh_save_regs_w {r11, lr}
+; O0W-NEXT:    mov r11, sp
+; O0W:         mov r0, r11
+; O0W-NEXT:    adds r0, #4
+; ELF:         push {r7, lr}
+; ELF:         mov r7, sp
+; ELF:         adds r0, r7, #4
+  %a = call ptr @llvm.addressofreturnaddress.p0()
+  store volatile ptr %a, ptr @r
+  ret void
+}
+
+; A non-leaf, which saves LR anyway.
+define void @nonleaf() noinline {
+; CHECK-LABEL: nonleaf:
+; O2W:         push.w {r11, lr}
+; O2W:         mov r11, sp
+; O2W:         add.w r0, r11, #4
+; O0W:         push.w {r11, lr}
+; O0W:         mov r11, sp
+; O0W:         mov r0, r11
+; O0W-NEXT:    adds r0, #4
+; ELF:         push {r7, lr}
+; ELF:         mov r7, sp
+; ELF:         adds r0, r7, #4
+  %a = call ptr @llvm.addressofreturnaddress.p0()
+  store volatile ptr %a, ptr @r
+  call void @callee()
+  ret void
+}
+
+; Callee-saved registers up to r11. On ELF Thumb2 the frame pointer is r7, so
+; the push is split at r7 to keep r7 and LR adjacent: one push {r4-r11, lr}
+; would leave r7 + 4 pointing at the saved r8. On Windows the frame pointer is
+; r11, which sits right below LR in a single push.
+@v = global i32 0
+define void @manycsr() noinline {
+; CHECK-LABEL: manycsr:
+; O2W:         push.w {r4, r5, r6, r7, r8, r9, r10, r11, lr}
+; O2W:         add.w r11, sp, #28
+; O2W:         add.w r0, r11, #4
+; O0W:         push.w {r4, r5, r6, r7, r8, r11, lr}
+; O0W:         add.w r11, sp, #20
+; O0W:         mov [[R:r[0-9]+]], r11
+; O0W-NEXT:    adds [[R]], #4
+; ELF:         push {r4, r5, r6, r7, lr}
+; ELF:         add r7, sp, #12
+; ELF:         push.w {r8, r9, r10, r11}
+; ELF:         adds r0, r7, #4
+  %x0 = load volatile i32, ptr @v
+  %x1 = load volatile i32, ptr @v
+  %x2 = load volatile i32, ptr @v
+  %x3 = load volatile i32, ptr @v
+  %x4 = load volatile i32, ptr @v
+  %x5 = load volatile i32, ptr @v
+  %x6 = load volatile i32, ptr @v
+  %x7 = load volatile i32, ptr @v
+  call void @callee()
+  %a = call ptr @llvm.addressofreturnaddress.p0()
+  store volatile ptr %a, ptr @r
+  store volatile i32 %x0, ptr @v
+  store volatile i32 %x1, ptr @v
+  store volatile i32 %x2, ptr @v
+  store volatile i32 %x3, ptr @v
+  store volatile i32 %x4, ptr @v
+  store volatile i32 %x5, ptr @v
+  store volatile i32 %x6, ptr @v
+  store volatile i32 %x7, ptr @v
+  ret void
+}
--- /dev/null
+++ b/llvm/test/CodeGen/ARM/coff-feat00.ll
@@ -0,0 +1,29 @@
+; RUN: llc -mtriple=thumbv7-windows-msvc -o - %s | FileCheck %s --check-prefix=PLAIN
+; RUN: sed -e s/.cfg:// %s | llc -mtriple=thumbv7-windows-msvc -o - | FileCheck %s --check-prefix=CFG
+; RUN: sed -e s/.cfg:// %s | llc -mtriple=thumbv7-windows-msvc -filetype=obj -o %t.obj
+; RUN: llvm-readobj --symbols %t.obj | FileCheck %s --check-prefix=OBJ
+
+; ARM COFF objects carry @feat.00, as x86 and AArch64 ones do. The linker
+; reads an object's .gfids/.giats tables only when @feat.00 has the /guard:cf
+; bit (0x800); without the symbol, lld-link /guard:cf left the address-taken
+; IAT table of an ARM32 image empty and never registered the delay-load thunk
+; of an address-taken import. MSVC's ARM cl emits it on every object too.
+
+declare dllimport i32 @imported()
+
+define ptr @take_address() {
+  ret ptr @imported
+}
+
+; ARM assembly quotes the name, since @ is not an identifier character here.
+; PLAIN: "@feat.00" = 0
+; CFG: "@feat.00" = 2048
+; CFG: .section .giats$y,"dr"
+; CFG-NEXT: .symidx __imp_imported
+
+; OBJ:      Name: @feat.00
+; OBJ-NEXT: Value: 2048
+; OBJ-NEXT: Section: IMAGE_SYM_ABSOLUTE
+
+!0 = !{i32 2, !"cfguard", i32 2}
+;cfg: !llvm.module.flags = !{!0}
--- /dev/null
+++ b/llvm/test/CodeGen/ARM/musttail-varargs-forward-thisadjust.ll
@@ -0,0 +1,89 @@
+; RUN: llc -verify-machineinstrs -mtriple=thumbv7-unknown-windows-msvc %s -o - | FileCheck %s
+; RUN: llc -verify-machineinstrs -mtriple=armv7-unknown-linux-gnueabihf %s -o - | FileCheck %s
+; RUN: llc -verify-machineinstrs -mtriple=armv7-unknown-linux-gnueabi %s -o - | FileCheck %s
+
+; The this-adjusting thunks of the Microsoft C++ ABI are variadic musttail
+; forwarders too, so they have to keep the unnamed argument registers intact for
+; the same reason a virtual member pointer thunk does.  They differ from it in
+; two ways that are worth covering separately: the register they need is a scratch
+; for an offset loaded out of the object rather than the branch target, the tail
+; branch is direct, and the "vtordispex" form needs two live values at once
+; because it walks a vbptr and then a vbtable.
+;
+; Clang reaches these shapes whenever the overrider's signature contains a type
+; it cannot lower yet - a member pointer to an incomplete class, or an incomplete
+; class passed by value - which makes the thunk unprototyped and therefore a
+; perfect-forwarding musttail thunk.  See clang/test/CodeGenCXX/ms-thunks-unprototyped.cpp
+; for the front end side.  The mangled names are "$4"/"$2"/"$0" (vtordisp) and
+; "$R4"/"$R2"/"$R0" (vtordispex); unlike "??_9...$B..." these look like ordinary
+; C++ symbols, so nothing downstream can pick them out by name.
+
+declare arm_aapcs_vfpcc void @adjusted_target(ptr, ...)
+declare arm_aapcs_vfpcc void @adjusted_target_ex(ptr, ...)
+declare arm_aapcs_vfpcc void @adjusted_target_nv(ptr, i32, i32, i32)
+
+; The "$4" vtordisp form: one load, one subtract, one direct tail branch.  The
+; unnamed arguments occupy r1-r3, so the offset has to be loaded somewhere else.
+define arm_aapcs_vfpcc void @vtordisp_thunk(ptr %this, ...) nounwind {
+; CHECK-LABEL: vtordisp_thunk:
+; CHECK:       ldr{{(\.w)?}} r12, [r0, #-4]
+; CHECK-NOT:   ldr{{(\.w)?}} r1,
+; CHECK-NOT:   ldr{{(\.w)?}} r2,
+; CHECK-NOT:   ldr{{(\.w)?}} r3,
+; CHECK:       sub{{(\.w)?}} r0, r0, r12
+; CHECK:       b{{(\.w)?}} adjusted_target
+  %offp = getelementptr inbounds i8, ptr %this, i32 -4
+  %off = load i32, ptr %offp, align 4
+  %negoff = sub i32 0, %off
+  %adj = getelementptr i8, ptr %this, i32 %negoff
+  musttail call arm_aapcs_vfpcc void (ptr, ...) @adjusted_target(ptr %adj, ...)
+  ret void
+}
+
+; The "$R" vtordispex form: vtordisp, then the vbptr, then a vbase offset out of
+; the vbtable.  Two values are live across the middle of it, and only one register
+; outside the argument window is available, so this is the shape that fails first
+; if the forwarded registers are not modelled.  Which registers the allocator
+; picks for the second value is not fixed by the ABI, so the assertions below pin
+; only the first load and then forbid every argument register for the rest of the
+; body; the final branch keeps the whole run from passing on a truncated body.
+define arm_aapcs_vfpcc void @vtordispex_thunk(ptr %this, ...) nounwind {
+; CHECK-LABEL: vtordispex_thunk:
+; CHECK:       ldr{{(\.w)?}} r12, [r0, #-4]
+; CHECK-NOT:   ldr{{(\.w)?}} r1,
+; CHECK-NOT:   ldr{{(\.w)?}} r2,
+; CHECK-NOT:   ldr{{(\.w)?}} r3,
+; CHECK:       b{{(\.w)?}} adjusted_target_ex
+  %offp = getelementptr inbounds i8, ptr %this, i32 -4
+  %off = load i32, ptr %offp, align 4
+  %negoff = sub i32 0, %off
+  %adj = getelementptr i8, ptr %this, i32 %negoff
+  %vbptrp = getelementptr inbounds i8, ptr %adj, i32 -8
+  %vbtable = load ptr, ptr %vbptrp, align 4
+  %vbslot = getelementptr inbounds i32, ptr %vbtable, i32 2
+  %vbase = load i32, ptr %vbslot, align 4
+  %adj2 = getelementptr inbounds i8, ptr %vbptrp, i32 %vbase
+  %adj3 = getelementptr i8, ptr %adj2, i32 8
+  musttail call arm_aapcs_vfpcc void (ptr, ...) @adjusted_target_ex(ptr %adj3, ...)
+  ret void
+}
+
+; Control: the same adjustment in a non-variadic forwarder whose four arguments
+; already fill r0-r3.  This one was compiled correctly before the forwarded
+; registers were modelled, which is what shows that the argument window being
+; live is the whole difference; its output must not change.
+define arm_aapcs_vfpcc void @vtordisp_nonvariadic_control(ptr %this, i32 %a, i32 %b, i32 %c) nounwind {
+; CHECK-LABEL: vtordisp_nonvariadic_control:
+; CHECK:       ldr{{(\.w)?}} r12, [r0, #-4]
+; CHECK-NOT:   ldr{{(\.w)?}} r1,
+; CHECK-NOT:   ldr{{(\.w)?}} r2,
+; CHECK-NOT:   ldr{{(\.w)?}} r3,
+; CHECK:       sub{{(\.w)?}} r0, r0, r12
+; CHECK:       b{{(\.w)?}} adjusted_target_nv
+  %offp = getelementptr inbounds i8, ptr %this, i32 -4
+  %off = load i32, ptr %offp, align 4
+  %negoff = sub i32 0, %off
+  %adj = getelementptr i8, ptr %this, i32 %negoff
+  musttail call arm_aapcs_vfpcc void @adjusted_target_nv(ptr %adj, i32 %a, i32 %b, i32 %c)
+  ret void
+}
--- /dev/null
+++ b/llvm/test/CodeGen/ARM/musttail-varargs-forward.ll
@@ -0,0 +1,110 @@
+; RUN: llc -verify-machineinstrs -mtriple=thumbv7-unknown-windows-msvc %s -o - | FileCheck %s
+; RUN: llc -verify-machineinstrs -mtriple=armv7-unknown-linux-gnueabihf %s -o - | FileCheck %s
+; RUN: llc -verify-machineinstrs -mtriple=armv7-unknown-linux-gnueabi %s -o - | FileCheck %s
+
+; A variadic function that forwards its arguments with a musttail call must
+; treat the unnamed argument registers as live.  Forwarders of exactly this
+; shape are what the Microsoft C++ ABI emits for a virtual member pointer call
+; ("??_9<class>@@$B<slot>AA") and for a thunk to an unprototyped function, so
+; picking one of them as scratch silently destroys the caller's first argument.
+; When the target returns a struct that argument is the hidden return buffer
+; pointer, which turns the defect into a wild store.
+;
+; Before this was fixed the vtable load was allocated the first still-unused
+; argument register - r1 for @fwd_variadic, r2 for @fwd_variadic_named1 - even
+; though the whole point of the function is to hand those registers on
+; untouched.
+
+; The unnamed arguments occupy r1-r3, so the scratch has to come from outside the
+; argument window; r12 is what the allocator reaches for, matching the
+; non-variadic forwarder at the bottom of this file.
+define arm_aapcs_vfpcc void @fwd_variadic(ptr %this, ...) nounwind {
+; CHECK-LABEL: fwd_variadic:
+; CHECK: ldr{{(\.w)?}} r12, [r0]
+; CHECK: ldr{{(\.w)?}} r12, [r12, #4]
+; CHECK: bx r12
+  %vt = load ptr, ptr %this, align 4
+  %slot = getelementptr inbounds ptr, ptr %vt, i32 1
+  %fn = load ptr, ptr %slot, align 4
+  musttail call arm_aapcs_vfpcc void (ptr, ...) %fn(ptr %this, ...)
+  ret void
+}
+
+; One named prefix argument in r1 was already respected; the unnamed window is
+; r2-r3, so again nothing in r0-r3 is free.
+define arm_aapcs_vfpcc void @fwd_variadic_named1(ptr %this, i32 %n, ...) nounwind {
+; CHECK-LABEL: fwd_variadic_named1:
+; CHECK: ldr{{(\.w)?}} r12, [r0]
+; CHECK: ldr{{(\.w)?}} r12, [r12, #4]
+; CHECK: bx r12
+  %vt = load ptr, ptr %this, align 4
+  %slot = getelementptr inbounds ptr, ptr %vt, i32 1
+  %fn = load ptr, ptr %slot, align 4
+  musttail call arm_aapcs_vfpcc void (ptr, i32, ...) %fn(ptr %this, i32 %n, ...)
+  ret void
+}
+
+; Two values are live at once, which previously took r1 *and* r2.  This is the
+; shape that matters for a struct-returning callee: the hidden return buffer
+; pointer travels in the unnamed window, so a second scratch register taken from
+; it is a wild store rather than a wrong argument.  Which registers the
+; allocator picks instead is not fixed by the ABI, so only assert that no
+; argument register is written or branched to.
+define arm_aapcs_vfpcc void @fwd_variadic_two_scratch(ptr %this, ...) nounwind {
+; CHECK-LABEL: fwd_variadic_two_scratch:
+; CHECK-NOT: ldr r1,
+; CHECK-NOT: ldr r2,
+; CHECK-NOT: ldr r3,
+; The register number must be anchored to end-of-line: FileCheck patterns are
+; substring searches over whitespace-canonicalized input, so a bare "bx r1"
+; also matches the "bx r12" this patch is supposed to produce.
+; CHECK-NOT: bx r1{{$}}
+; CHECK-NOT: bx r2{{$}}
+; CHECK-NOT: bx r3{{$}}
+; A positive anchor as well, so a truncated or empty label block cannot satisfy
+; the CHECK-NOTs vacuously.  Which non-argument register the allocator picks is
+; not fixed by the ABI, so accept any of them.
+; CHECK: bx {{r([4-9]|1[012])}}
+  %vt = load ptr, ptr %this, align 4
+  %s1 = getelementptr inbounds ptr, ptr %vt, i32 1
+  %f1 = load ptr, ptr %s1, align 4
+  %s2 = getelementptr inbounds ptr, ptr %vt, i32 5
+  %f2 = load ptr, ptr %s2, align 4
+  %c = icmp eq ptr %f1, null
+  %fn = select i1 %c, ptr %f2, ptr %f1
+  musttail call arm_aapcs_vfpcc void (ptr, ...) %fn(ptr %this, ...)
+  ret void
+}
+
+; The same defect reaches a second kind of thunk: a this-adjusting ("$4"
+; vtordisp) thunk under virtual inheritance is also a variadic musttail
+; forwarder, but its scratch register holds an offset loaded from the object and
+; its tail branch is direct.  Unlike the virtual member pointer thunks these
+; carry an ordinary mangled name.
+declare arm_aapcs_vfpcc void @adjusted_target(ptr, ...)
+
+define arm_aapcs_vfpcc void @fwd_variadic_thisadjust(ptr %this, ...) nounwind {
+; CHECK-LABEL: fwd_variadic_thisadjust:
+; CHECK: ldr{{(\.w)?}} r12, [r0, #-4]
+; CHECK: sub{{(s|\.w)?}} r0, r0, r12
+  %offp = getelementptr inbounds i8, ptr %this, i32 -4
+  %off = load i32, ptr %offp, align 4
+  %negoff = sub i32 0, %off
+  %adj = getelementptr inbounds i8, ptr %this, i32 %negoff
+  musttail call arm_aapcs_vfpcc void (ptr, ...) @adjusted_target(ptr %adj, ...)
+  ret void
+}
+
+; Control: a non-variadic forwarder whose four arguments already fill r0-r3 was
+; always compiled correctly.  Its output must not change.
+define arm_aapcs_vfpcc void @fwd_nonvariadic_all4(ptr %this, i32 %a, i32 %b, i32 %c) nounwind {
+; CHECK-LABEL: fwd_nonvariadic_all4:
+; CHECK: ldr{{(\.w)?}} r12, [r0]
+; CHECK: ldr{{(\.w)?}} r12, [r12, #4]
+; CHECK: bx r12
+  %vt = load ptr, ptr %this, align 4
+  %slot = getelementptr inbounds ptr, ptr %vt, i32 1
+  %fn = load ptr, ptr %slot, align 4
+  musttail call arm_aapcs_vfpcc void %fn(ptr %this, i32 %a, i32 %b, i32 %c)
+  ret void
+}
--- /dev/null
+++ b/llvm/test/CodeGen/ARM/musttail-varargs-vastart.ll
@@ -0,0 +1,206 @@
+; RUN: rm -rf %t && split-file %s %t
+
+; The three triples the other ARM musttail forwarder tests use: Thumb2/COFF with
+; SEH unwind, Thumb2/ELF, and ARM mode.  The epilogue that has to release the
+; argument-register save area before the tail branch is target-independent, so
+; all three must show it.
+; RUN: llc -verify-machineinstrs -mtriple=thumbv7-unknown-windows-msvc %t/tail.ll -o - | FileCheck %s
+; RUN: llc -verify-machineinstrs -mtriple=thumbv7-unknown-linux-gnueabihf %t/tail.ll -o - | FileCheck %s
+; RUN: llc -verify-machineinstrs -mtriple=armv7-unknown-linux-gnueabi %t/tail.ll -o - | FileCheck %s
+
+; The frame, read out of the post-PEI MIR rather than inferred from the asm.
+; RUN: llc -mtriple=thumbv7-unknown-windows-msvc -stop-after=prolog-epilog %t/tail.ll -o - | FileCheck %s --check-prefix=MIR
+
+; A split byval caller: LLVM 23 performs this musttail itself, outside the
+; change (stock 23.1.0 emits identical code).
+; RUN: llc -verify-machineinstrs -mtriple=thumbv7-unknown-windows-msvc %t/byval.ll -o - | FileCheck %s --check-prefix=BYVAL
+
+; The shape that must STILL be rejected.
+; RUN: not --crash llc -mtriple=thumbv8m.base-none-eabi %t/thumb1.ll -o - 2>&1 | FileCheck %s --check-prefix=FATAL
+
+; A variadic function that calls va_start gets an argument-register save area,
+; and ARMTargetLowering::IsEligibleForTailCallOptimization used to refuse every
+; tail call out of such a function.  For an ordinary call that is invisible - it
+; silently becomes a non-tail call - but a musttail call has nowhere to go and
+; LowerCall turns the refusal into "failed to perform tail call elimination on a
+; call site marked musttail".  A variadic forwarder that inspects its own
+; arguments before handing them on was therefore not compilable at all.
+;
+; The save area has two producers that LowerFormalArguments adds into one
+; counter: byval parameters split between registers and the stack, and the
+; va_start register window.  The change concerns only the va_start half, where
+; nothing outlives the frame.  The byval half is LLVM 23's own business: it
+; tail-calls past a split byval itself (byval_split_tail below; and
+; byval_split_musttail in byval.ll, copying the object into the outgoing
+; argument area before the branch), and the change must leave that as it is.
+
+;--- tail.ll
+
+declare void @llvm.va_start(ptr)
+declare void @llvm.va_end(ptr)
+declare void @sink(ptr)
+declare void @plain()
+
+%struct.big = type { [8 x i32] }
+
+; POSITIVE.  This is the shape that used to abort the backend: the whole
+; unnamed window r1-r3 is spilled for va_start, read through the va_list, and
+; then handed on unchanged by a musttail call.
+;
+; Three things have to be true at the branch, and each is asserted below:
+;   1. the save area is allocated and written (sub sp / stm),
+;   2. r1-r3 survive the intervening call and are restored (patch 0003's
+;      forwarding, which only becomes observable now that the call is a real
+;      tail call),
+;   3. SP is back at the incoming value before the branch - the save area is
+;      released *after* the callee-saved pop, by the "add sp, #12" that mirrors
+;      the "sub sp, #12" in the prologue.
+define void @fwd_vastart(ptr %pfn, ...) nounwind {
+; CHECK-LABEL: fwd_vastart:
+; CHECK:       sub sp, {{(sp, )?}}#12
+; CHECK:       stm r0{{!?}}, {r1, r2, r3}
+; CHECK:       bl sink
+; CHECK:       mov r1, r{{[0-9]+}}
+; CHECK-NEXT:  mov r2, r{{[0-9]+}}
+; CHECK-NEXT:  mov r3, r{{[0-9]+}}
+; CHECK:       pop{{(\.w)?}} {
+; CHECK:       add sp, {{(sp, )?}}#12
+; CHECK:       bx r{{[0-9]+$}}
+entry:
+  %ap = alloca ptr, align 4
+  call void @llvm.va_start(ptr %ap)
+  call void @sink(ptr %ap)
+  call void @llvm.va_end(ptr %ap)
+  musttail call void (ptr, ...) %pfn(ptr %pfn, ...)
+  ret void
+}
+
+; POSITIVE, one named prefix argument.  The unnamed window is r2-r3, so the save
+; area is 8 bytes rather than 12 and the epilogue has to release exactly that.
+define void @fwd_vastart_named1(ptr %pfn, i32 %n, ...) nounwind {
+; CHECK-LABEL: fwd_vastart_named1:
+; CHECK:       sub sp, {{(sp, )?}}#8
+; CHECK:       bl sink
+; CHECK:       pop{{(\.w)?}} {
+; CHECK:       add sp, {{(sp, )?}}#8
+; CHECK:       bx r{{[0-9]+$}}
+entry:
+  %ap = alloca ptr, align 4
+  call void @llvm.va_start(ptr %ap)
+  call void @sink(ptr %ap)
+  call void @llvm.va_end(ptr %ap)
+  musttail call void (ptr, i32, ...) %pfn(ptr %pfn, i32 %n, ...)
+  ret void
+}
+
+; ARMED FLOOR for the two negatives below.  Same variadic signature, no
+; va_start, so there is no save area and the tail call happens.  On LLVM 23 the
+; very next function, which differs from this one only by the presence of
+; va_start, tail-calls too (LLVM 18 emitted a call-and-return there): the pair
+; checks that va_start does not change the code generator's decision for an
+; ordinary call.  Each negative forbids the call-and-return explicitly, so it is
+; not a directive that could never read the other way: LLVM 18's output fails it.
+define void @tail_novastart(ptr %pfn, ...) nounwind {
+; CHECK-LABEL: tail_novastart:
+; CHECK:       b plain
+entry:
+  tail call void @plain()
+  ret void
+}
+
+; NEGATIVE - the scope of the change.  An ORDINARY call in a va_start variadic
+; function keeps the code generator's own decision; the change must not alter
+; it.  LLVM 23 tail-calls this one (stock 23.1.0 emits `b plain` for all three
+; triples above; LLVM 18 emitted `bl plain`), so the expected output is LLVM
+; 23's, unchanged.
+define void @tail_vastart(ptr %pfn, ...) nounwind {
+; CHECK-LABEL: tail_vastart:
+; CHECK-NOT:   bl plain
+; CHECK:       b plain
+entry:
+  %ap = alloca ptr, align 4
+  call void @llvm.va_start(ptr %ap)
+  call void @llvm.va_end(ptr %ap)
+  tail call void @plain()
+  ret void
+}
+
+; NEGATIVE - a caller with a byval argument split between r3 and the stack.
+; StoreByValRegs writes the r3 half into a fixed object below the CFA (the
+; "sub sp, #4") and sink() is handed its address by an ordinary call.  The
+; later call to plain() never receives it, and LLVM 23 tail-calls it after the
+; object is released (stock 23.1.0 emits the same `b plain` for all three
+; triples); the change must leave that exactly as it is.
+define void @byval_split_tail(i32 %a, i32 %b, i32 %c, ptr byval(%struct.big) align 4 %s) nounwind {
+; CHECK-LABEL: byval_split_tail:
+; CHECK:       sub sp, {{(sp, )?}}#4
+; CHECK:       bl sink
+; CHECK-NOT:   bl plain
+; CHECK:       b plain
+entry:
+  call void @sink(ptr %s)
+  tail call void @plain()
+  ret void
+}
+
+; MIR-LABEL: name: fwd_vastart
+; MIR: hasVAStart: true
+; MIR: hasMustTailInVarArgFunc: true
+; MIR: hasTailCall: true
+;
+; The save area, named rather than inferred: 12 bytes at CFA-12.
+; MIR: fixedStack:
+; MIR-NEXT: - { id: 0, type: default, offset: -12, size: 12,
+;
+; SP at the tail branch: -12 (save area) -24 (six callee-saved) -4 (locals) in
+; the prologue, and +4 +24 +12 in the epilogue, so the branch is taken with SP
+; back at its incoming value.  The TCRETURN's second operand is the SPDiff, and
+; it is 0 - this is a sibling call, so the callee finds its stack arguments
+; exactly where this function found its own.
+; MIR: $sp = frame-setup tSUBspi $sp, 3,
+; MIR: $sp = frame-destroy tADDspi $sp, 1,
+; MIR: $sp = frame-destroy t2LDMIA_UPD $sp,
+; MIR: $sp = frame-destroy tADDspi $sp, 3,
+; MIR: TCRETURNri killed renamable $r0, 0, csr_aapcs, implicit $sp, implicit $r1, implicit $r2, implicit $r3
+
+;--- byval.ll
+
+; A musttail call out of a caller with a byval argument split between r3 and
+; the stack.  Under LLVM 18 this failed; LLVM 23 lowers it itself, copying the
+; byval object into the outgoing argument area before the tail branch, and
+; stock 23.1.0 emits exactly the code below.  This is outside the change: it
+; must stay as LLVM 23 emits it.
+; BYVAL-LABEL: byval_split_musttail:
+; BYVAL:       sub sp, #4
+; BYVAL-NOT:   bl byval_callee
+; BYVAL:       b byval_callee
+%struct.big = type { [8 x i32] }
+declare void @byval_callee(i32, i32, i32, ptr byval(%struct.big) align 4)
+
+define void @byval_split_musttail(i32 %a, i32 %b, i32 %c, ptr byval(%struct.big) align 4 %s) nounwind {
+entry:
+  musttail call void @byval_callee(i32 %a, i32 %b, i32 %c, ptr byval(%struct.big) align 4 %s)
+  ret void
+}
+
+;--- thumb1.ll
+
+; Thumb1 is deliberately left on the old path.  There the save area is released
+; by Thumb1FrameLowering::emitPopSpecialFixUp, which is written around a
+; tBX_RET/tPOP_RET terminator and not around a TCRETURN, so a v8m.baseline
+; forwarder still reports the error rather than taking an untested epilogue.
+declare void @llvm.va_start(ptr)
+declare void @llvm.va_end(ptr)
+declare void @sink(ptr)
+
+define void @fwd_vastart_thumb1(ptr %pfn, ...) nounwind {
+entry:
+  %ap = alloca ptr, align 4
+  call void @llvm.va_start(ptr %ap)
+  call void @sink(ptr %ap)
+  call void @llvm.va_end(ptr %ap)
+  musttail call void (ptr, ...) %pfn(ptr %pfn, ...)
+  ret void
+}
+
+; FATAL: LLVM ERROR: failed to perform tail call elimination on a call site marked musttail
--- /dev/null
+++ b/llvm/test/CodeGen/ARM/wineh-cxx-eh-align-catchobj.ll
@@ -0,0 +1,48 @@
+; RUN: not llc -mtriple=thumbv7-pc-windows-msvc < %s -o %t.s 2>&1 | FileCheck %s
+
+; A catch object aligned above the 8-byte stack alignment. The runtime writes
+; the caught exception at a constant offset from SP at function entry, so the
+; object can neither live in a realigned frame (C++ EH frames are never
+; realigned) nor at an address computed at run time. The backend refuses it
+; with an error diagnostic naming the function -- not a crash, and not code
+; the runtime would misread. The same holds for an over-aligned local passed
+; to llvm.localescape (hand-written IR; clang emits it only for SEH): the
+; funclets address it by its frame index, so it cannot be moved either.
+
+; CHECK: error: {{.*}}in function catch_overaligned{{.*}}Windows C++ exception handling on ARM: the catch object is 16-byte aligned, but the stack is only 8-byte aligned
+; CHECK: error: {{.*}}in function esc{{.*}}Windows C++ exception handling on ARM: a local passed to llvm.localescape is 16-byte aligned, but the stack is only 8-byte aligned
+; CHECK-NOT: PLEASE submit a bug report
+
+%struct.A = type { [4 x i32] }
+@ti = external global i8
+declare void @g()
+declare void @use(ptr)
+declare i32 @__CxxFrameHandler3(...)
+
+define void @catch_overaligned() personality ptr @__CxxFrameHandler3 {
+entry:
+  %e = alloca %struct.A, align 16
+  invoke void @g() to label %ret unwind label %dispatch
+dispatch:
+  %cs = catchswitch within none [label %catch] unwind to caller
+catch:
+  %cp = catchpad within %cs [ptr @ti, i32 8, ptr %e]
+  call void @use(ptr %e) [ "funclet"(token %cp) ]
+  catchret from %cp to label %ret
+ret:
+  ret void
+}
+
+declare void @llvm.localescape(...)
+define void @esc() personality ptr @__CxxFrameHandler3 {
+entry:
+  %a = alloca [16 x i8], align 16
+  call void (...) @llvm.localescape(ptr %a)
+  invoke void @g() to label %cont unwind label %cleanup
+cont:
+  ret void
+cleanup:
+  %p = cleanuppad within none []
+  call void @use(ptr null) [ "funclet"(token %p) ]
+  cleanupret from %p unwind to caller
+}
--- /dev/null
+++ b/llvm/test/CodeGen/ARM/wineh-cxx-eh-align.ll
@@ -0,0 +1,82 @@
+; RUN: llc -O2 -mtriple=thumbv7-pc-windows-msvc < %s | FileCheck %s
+; RUN: llc -O0 -mtriple=thumbv7-pc-windows-msvc < %s -o %t.O0.s
+
+; Windows C++ EH frames are never dynamically realigned, as MSVC never realigns
+; them: the EH tables give UnwindHelp and the catch objects as constant offsets
+; from SP at function entry, which a realigned frame does not have.
+;  - A stack temporary the code generator creates for a vector (here for a
+;    variable-index extractelement) is capped at the 8-byte stack alignment, so
+;    it is stored without a :128 alignment hint and the frame is not realigned.
+;  - An alloca aligned above 8 gets an aligned address computed inside an
+;    over-sized 8-aligned block; the cleanup funclet reaches that address
+;    through r6, the parent's frame base.
+; The -O0 RUN line only has to compile: before, both functions stopped the
+; backend there too. "mov r6, sp" right after the prologue is what a realigned
+; frame does not have (it realigns SP between the two).
+; The calls are to external functions, so none of the EH can be proved dead.
+
+@vec = global <4 x i32> zeroinitializer, align 16
+@idx = global i32 0
+@out = global i32 0
+declare void @g()
+declare void @dtor()
+declare void @use(ptr)
+declare i32 @__CxxFrameHandler3(...)
+
+define void @vectemp() personality ptr @__CxxFrameHandler3 {
+; CHECK-LABEL: vectemp:
+; CHECK:       push {r6, lr}
+; CHECK:       sub sp, #[[#VT_SUB:]]
+; CHECK:       .seh_endprologue
+; CHECK-NEXT:  mov r6, sp
+; CHECK:       add.w [[TMP:r[0-9]+]], r6, #{{[0-9]+}}
+; CHECK:       vst1.64 {d16, d17}, {{\[}}[[TMP]]{{\]}}, r{{[0-9]+}}
+; CHECK:       $cppxdata$vectemp:
+; CHECK:       .long [[#%d,0 - VT_SUB - 8]] @ UnwindHelp
+; CHECK-NEXT:  .long 0 @ ESTypeList
+; CHECK-NEXT:  .long 1 @ EHFlags
+entry:
+  %v = load volatile <4 x i32>, ptr @vec, align 16
+  %i = load volatile i32, ptr @idx
+  %e = extractelement <4 x i32> %v, i32 %i
+  store volatile i32 %e, ptr @out
+  invoke void @g() to label %cont unwind label %cleanup
+cont:
+  ret void
+cleanup:
+  %p = cleanuppad within none []
+  call void @dtor() [ "funclet"(token %p) ]
+  cleanupret from %p unwind to caller
+}
+
+; A 32-byte aligned local: block + 24, then bits 3-4 cleared (the block is
+; already 8-byte aligned), is the first 32-byte aligned address in the block.
+define void @overaligned() personality ptr @__CxxFrameHandler3 {
+; CHECK-LABEL: overaligned:
+; CHECK:       push {r6, lr}
+; CHECK:       sub sp, #[[#OA_SUB:]]
+; CHECK:       .seh_endprologue
+; CHECK-NEXT:  mov r6, sp
+; CHECK:       add.w [[P:r[0-9]+]], r6, #{{[0-9]+}}
+; CHECK-NEXT:  adds [[P]], #24
+; CHECK:       bic [[P]], [[P]], #24
+; CHECK:       str [[P]], [r6, #[[#OA_SLOT:]]]
+; CHECK:       bl use
+; CHECK-LABEL: "?dtor$2@?0?overaligned@4HA":
+; CHECK:       .seh_endprologue
+; CHECK-NEXT:  ldr r0, [r6, #[[#OA_SLOT]]]
+; CHECK-NEXT:  bl use
+; CHECK:       $cppxdata$overaligned:
+; CHECK:       .long [[#%d,0 - OA_SUB - 8]] @ UnwindHelp
+entry:
+  %buf = alloca [8 x i32], align 32
+  call void @use(ptr %buf)
+  invoke void @g() to label %cont unwind label %cleanup
+cont:
+  call void @use(ptr %buf)
+  ret void
+cleanup:
+  %p = cleanuppad within none []
+  call void @use(ptr %buf) [ "funclet"(token %p) ]
+  cleanupret from %p unwind to caller
+}
--- /dev/null
+++ b/llvm/test/CodeGen/ARM/wineh-cxx-eh.ll
@@ -0,0 +1,172 @@
+; RUN: llc -O2 -mtriple=thumbv7-pc-windows-msvc < %s | FileCheck %s
+
+; C++ exception handling (__CxxFrameHandler3) on Windows ARM, checked against
+; what MSVC's ARM compiler emits and what its runtime reads:
+;  - FuncInfo has all ten words: UnwindHelp, then ESTypeList 0, EHFlags 1.
+;  - Every displacement is from SP at function entry (the establisher frame):
+;    the parent pushes PUSH bytes of registers and then subtracts SUB, so its
+;    frame base r6 is entry-SP - PUSH - SUB, and a slot at r6+K is at
+;    K - PUSH - SUB.  Each function checks its own push list.
+;  - UnwindHelp (8 bytes, 8-byte aligned as MSVC's) gets -2 in both words
+;    before the first call; in these frames it is the lowest slot, r6+0.
+;  - A catch funclet returns its continuation in r0, as one adjacent
+;    movw/movt pair (a single MOV32T relocation), and that block is
+;    address-taken.
+;  - Funclets reach the parent frame only through r6, even with a frame
+;    pointer: inside a funclet, SP and r11 are the funclet's own.
+; The calls are to external functions, so none of the EH can be proved dead.
+
