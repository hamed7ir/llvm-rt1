+// REQUIRES: arm
+// RUN: llvm-mc -filetype=obj -triple=thumbv7-windows %s -o %t.obj
+// RUN: not lld-link -entry:main -subsystem:console %t.obj -out:%t.exe 2>&1 | FileCheck %s
+
+// A link that can never converge. main's bne.w (IMAGE_REL_ARM_BRANCH20T,
+// +-1 MB) is at the start of a 2 MB section chunk and its target is in another
+// chunk after it. The only place for a range extension thunk is right after
+// main's chunk, still out of range, so no margin can help. Each type's margin
+// stops at the width from which every relocation of the type is thunked anyway
+// (1 MB for BRANCH20T: four doublings from 100 KB), so lld gives up on the
+// fifth pass, when no margin is left to widen -- not after a fixed number of
+// passes spent doubling a margin that cannot help, and possibly overflowing it.
+
+// CHECK: adding thunks hasn't converged after 5 passes
+
+    .syntax unified
+    .globl main
+    .text
+    .def main; .scl 2; .type 32; .endef
+main:
+    bne.w far
+    bx lr
+    .space 0x200000
+    .section .text$b, "xr"
+    .def far; .scl 2; .type 32; .endef
+    .globl far
+far:
+    bx lr
