0018  lld-link: BRANCH20T writes J1/J2 the right way round (B7)

Generated by rt21fix\patches\make_rt21fix_patches.py from the saved pre-states; see the
applier rt21fix\patches\apply_0018.py for the rationale and the measurements behind it.

--- a/lld/COFF/Chunks.cpp
+++ b/lld/COFF/Chunks.cpp
@@ -198,9 +198,11 @@
 static void applyBranch20T(uint8_t *off, int32_t v) {
   if (!isInt<21>(v))
     error("relocation out of range");
+  // Encoding T3: imm32 = SignExtend(S:J2:J1:imm6:imm11:'0'), so J2 is offset
+  // bit 19 and J1 is bit 18 (unlike T4 below, where I1 is bit 23).
   uint32_t s = v < 0 ? 1 : 0;
-  uint32_t j1 = (v >> 19) & 1;
-  uint32_t j2 = (v >> 18) & 1;
+  uint32_t j1 = (v >> 18) & 1;
+  uint32_t j2 = (v >> 19) & 1;
   or16(off, (s << 10) | ((v >> 12) & 0x3f));
   or16(off + 2, (j1 << 13) | (j2 << 11) | ((v >> 1) & 0x7ff));
 }
