+// REQUIRES: arm
+// RUN: llvm-mc -filetype=obj -triple=thumbv7-windows %s -o %t.obj
+// RUN: lld-link -entry:start -subsystem:console %t.obj -out:%t.exe
+// RUN: llvm-objdump --no-print-imm-hex -d %t.exe --start-address=0x401000 --stop-address=0x401010 | FileCheck %s
+// RUN: llvm-objdump --no-print-imm-hex -d %t.exe --start-address=0x4e2002 --stop-address=0x4e200a | FileCheck --check-prefix=BACK %s
+
+// IMAGE_REL_ARM_BRANCH20T is B<cond>.W (encoding T3), whose offset is
+// S:J2:J1:imm6:imm11:'0' -- J2 holds offset bit 19 and J1 bit 18. Four
+// conditional branches to targets 100, 300, 600 and 900 KB ahead cover every
+// pattern of those two bits; each must decode to its own target. With J1 and
+// J2 swapped, the 300 KB and 600 KB branches land 256 KB off. Backward branches
+// have their own patterns: about -300 KB has bit 19 set and bit 18 clear, about
+// -600 KB the reverse, so with J1 and J2 swapped both land 256 KB off too.
+
+// CHECK:      401000: {{.*}}bne.w 0x41a000
+// CHECK-NEXT: 401004: {{.*}}bne.w 0x44c000
+// CHECK-NEXT: 401008: {{.*}}bne.w 0x497000
+// CHECK-NEXT: 40100c: {{.*}}bne.w 0x4e2000
+
+// BACK:      4e2002: {{.*}}bne.w 0x497000
+// BACK-NEXT: 4e2006: {{.*}}bne.w 0x44c000
+
+    .syntax unified
+    .text
+    .def start; .scl 2; .type 32; .endef
+    .globl start
+start:
+    bne.w t100
+    bne.w t300
+    bne.w t600
+    bne.w t900
+    bx lr
+    .section .text$a,"xr"
+    .space 100*1024 - 18
+    .section .text$b,"xr"
+    .def t100; .scl 2; .type 32; .endef
+    .globl t100
+t100:
+    bx lr
+    .space 200*1024 - 2
+    .def t300; .scl 2; .type 32; .endef
+    .globl t300
+t300:
+    bx lr
+    .space 300*1024 - 2
+    .def t600; .scl 2; .type 32; .endef
+    .globl t600
+t600:
+    bx lr
+    .space 300*1024 - 2
+    .def t900; .scl 2; .type 32; .endef
+    .globl t900
+t900:
+    bx lr
+    bne.w t600
+    bne.w t300
+    bx lr
