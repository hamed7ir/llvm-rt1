+// REQUIRES: arm
+// RUN: llvm-mc -filetype=obj -triple=thumbv7-windows %s -o %t.obj
+// RUN: lld-link -entry:main -subsystem:console %t.obj -out:%t.exe -verbose 2>&1 | FileCheck -check-prefix=VERBOSE %s
+// RUN: llvm-objdump --no-print-imm-hex -d %t.exe --start-address=0x401000 --stop-address=0x401008 | FileCheck --check-prefix=MAIN %s
+
+// A branch to a function in its own section chunk is not sent through a range
+// extension thunk while it is in range: thunks are only inserted between
+// chunks, so its distance can never change. A thunk would clobber r12, which
+// code such as MSVC's __rt_sdiv keeps live across a local conditional branch.
+// local_target is in range of the first bne.w (0xF0000 bytes ahead) but inside
+// the initial 100 KB margin of the end of BRANCH20T's range, so a margin-based
+// check alone would thunk it. far_target is genuinely out of range and still
+// gets the one thunk.
+// (local_target is declared as a function so that the assembler keeps the
+// relocation instead of resolving the branch itself.)
+
+// VERBOSE: Added 1 thunks with margin 102400 in 1 passes
+
+// MAIN: 401000: {{.*}}bne.w 0x4f1004 <.text+0xf0004>
+// MAIN-NEXT: 401004: {{.*}}bne.w 0x4f1006 <.text+0xf0006>
+
+    .syntax unified
+    .globl main
+    .text
+    .def main; .scl 2; .type 32; .endef
+main:
+    bne.w local_target
+    bne.w far_target
+    bx lr
+    .space 0xF0000 - 6
+    .def local_target; .scl 3; .type 32; .endef
+local_target:
+    bx lr
+    .section .text$z, "xr"
+    .space 0x100000
+    .def far_target; .scl 2; .type 32; .endef
+    .globl far_target
+far_target:
+    bx lr
