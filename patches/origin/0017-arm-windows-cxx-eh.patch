+++ b/llvm/test/CodeGen/ARM/wineh-cxx-eh.ll
@@ -0,0 +1,172 @@
+; RUN: llc -O2 -mtriple=thumbv7-pc-windows-msvc < %s | FileCheck %s
+
+; C++ exception handling (__CxxFrameHandler3) on Windows ARM, checked against
+; what MSVC's ARM compiler emits and what its runtime reads:
+;  - FuncInfo has all ten words: UnwindHelp, then ESTypeList 0, EHFlags 1.
+;  - Every displacement is from SP at function entry (the establisher frame):
+;    the parent pushes PUSH bytes of registers and then subtracts SUB, so its
+;    frame base r6 is entry-SP - PUSH - SUB, and a slot at r6+K is at
+;    K - PUSH - SUB.  Each function checks its own push list.
+;  - UnwindHelp (8 bytes, 8-byte aligned as MSVC's) gets -2 in both words
+;    before the first call; in these frames it is the lowest slot, r6+0.
+;  - A catch funclet returns its continuation in r0, as one adjacent
+;    movw/movt pair (a single MOV32T relocation), and that block is
+;    address-taken.
+;  - Funclets reach the parent frame only through r6, even with a frame
+;    pointer: inside a funclet, SP and r11 are the funclet's own.
+; The calls are to external functions, so none of the EH can be proved dead.
+
+%rtti.TypeDescriptor7 = type { ptr, ptr, [8 x i8] }
+%struct.E = type { i32 }
+$"??_R0?AUE@@@8" = comdat any
+@"??_7type_info@@6B@" = external constant ptr
+@"??_R0?AUE@@@8" = linkonce_odr global %rtti.TypeDescriptor7 { ptr @"??_7type_info@@6B@", ptr null, [8 x i8] c".?AUE@@\00" }, comdat
+
+declare void @g()
+declare i32 @use(i32)
+declare void @dtor(ptr)
+declare i32 @__CxxFrameHandler3(...)
+
+; A destructor to run during unwinding and nothing to catch.
+define void @cleanup_only() personality ptr @__CxxFrameHandler3 {
+; CHECK-LABEL: cleanup_only:
+; CHECK:       .seh_handler __CxxFrameHandler3, %unwind, %except
+; CHECK:       push {r6, lr}
+; CHECK:       sub sp, #[[#CO_SUB:]]
+; CHECK:       .seh_endprologue
+; CHECK-NEXT:  mov r6, sp
+; CHECK-NEXT:  mvn [[CO_T:r[0-9]+]], #1
+; CHECK-NEXT:  str.w [[CO_T]], [r6]
+; CHECK-NEXT:  str.w [[CO_T]], [r6, #4]
+; CHECK-NEXT:  $Mtmp{{[0-9]+}}:
+; CHECK-NEXT:  bl g
+; CHECK:       $cppxdata$cleanup_only:
+; CHECK-NEXT:  .long 429065506 @ MagicNumber
+; CHECK:       .long [[#%d,0 - CO_SUB - 8]] @ UnwindHelp
+; CHECK-NEXT:  .long 0 @ ESTypeList
+; CHECK-NEXT:  .long 1 @ EHFlags
+entry:
+  %s = alloca i32, align 4
+  invoke void @g() to label %cont unwind label %cleanup
+cont:
+  call void @dtor(ptr %s)
+  ret void
+cleanup:
+  %p = cleanuppad within none []
+  call void @dtor(ptr %s) [ "funclet"(token %p) ]
+  cleanupret from %p unwind to caller
+}
+
+; catch (...) without a catch object.
+define i32 @catch_all() personality ptr @__CxxFrameHandler3 {
+; CHECK-LABEL: catch_all:
+; CHECK:       push {r6, lr}
+; CHECK:       sub sp, #[[#CA_SUB:]]
+; CHECK:       mvn [[CA_T:r[0-9]+]], #1
+; CHECK-NEXT:  str.w [[CA_T]], [r6]
+; CHECK-NEXT:  str.w [[CA_T]], [r6, #4]
+; CHECK:       [[CA_CONT:\$MBB[0-9_]+]]: @ Block address taken
+; CHECK-LABEL: "?catch$3@?0?catch_all@4HA":
+; CHECK:       .seh_handler __CxxFrameHandler3, %unwind, %except
+; CHECK:       movw r0, :lower16:[[CA_CONT]]
+; CHECK-NEXT:  movt r0, :upper16:[[CA_CONT]]
+; CHECK-NEXT:  .seh_startepilogue
+; CHECK:       bx lr
+; CHECK:       $cppxdata$catch_all:
+; CHECK:       .long [[#%d,0 - CA_SUB - 8]] @ UnwindHelp
+; CHECK-NEXT:  .long 0 @ ESTypeList
+; CHECK-NEXT:  .long 1 @ EHFlags
+; CHECK:       .long 64 @ Adjectives
+; CHECK-NEXT:  .long 0 @ Type
+; CHECK-NEXT:  .long 0 @ CatchObjOffset
+; CHECK-NEXT:  .long "?catch$3@?0?catch_all@4HA"@imgrel @ Handler
+; CHECK-NEXT:  .long 0 @ ParentFrameOffset
+entry:
+  invoke void @g() to label %done unwind label %dispatch
+dispatch:
+  %cs = catchswitch within none [label %catch] unwind to caller
+catch:
+  %cp = catchpad within %cs [ptr null, i32 64, ptr null]
+  catchret from %cp to label %done
+done:
+  %r = phi i32 [ 1, %catch ], [ 0, %entry ]
+  ret i32 %r
+}
+
+; catch (E e) by value: the runtime copies the exception into the catch
+; object at establisher frame + CatchObjOffset; the funclet must read it there.
+; The funclet keeps use()'s result in a callee-saved register across the
+; destructor call, which gives the scheduler an instruction it could place
+; between movw and movt -- the pair must stay adjacent anyway.
+define i32 @catch_obj() personality ptr @__CxxFrameHandler3 {
+; CHECK-LABEL: catch_obj:
+; CHECK:       push.w {r4, r6, r11, lr}
+; CHECK-NEXT:  .seh_save_regs_w {r4, r6, r11, lr}
+; CHECK-NEXT:  sub sp, #[[#CB_SUB:]]
+; CHECK:       .seh_endprologue
+; CHECK-NEXT:  mov r6, sp
+; CHECK-NEXT:  mvn [[CB_T:r[0-9]+]], #1
+; CHECK-NEXT:  str.w [[CB_T]], [r6]
+; CHECK-NEXT:  str.w [[CB_T]], [r6, #4]
+; CHECK:       [[CB_CONT:\$MBB[0-9_]+]]: @ Block address taken
+; CHECK-LABEL: "?catch$3@?0?catch_obj@4HA":
+; CHECK:       ldr r0, [r6, #[[#CB_OBJ:]]]
+; CHECK:       bl use
+; CHECK:       bl dtor
+; CHECK:       movw r0, :lower16:[[CB_CONT]]
+; CHECK-NEXT:  movt r0, :upper16:[[CB_CONT]]
+; CHECK:       $cppxdata$catch_obj:
+; CHECK:       .long [[#%d,0 - CB_SUB - 16]] @ UnwindHelp
+; CHECK:       .long "??_R0?AUE@@@8"@imgrel @ Type
+; CHECK-NEXT:  .long [[#%d,CB_OBJ - CB_SUB - 16]] @ CatchObjOffset
+entry:
+  %e = alloca %struct.E, align 4
+  invoke void @g() to label %done unwind label %dispatch
+dispatch:
+  %cs = catchswitch within none [label %catch] unwind to caller
+catch:
+  %cp = catchpad within %cs [ptr @"??_R0?AUE@@@8", i32 0, ptr %e]
+  %v = load i32, ptr %e, align 4
+  %u = invoke i32 @use(i32 %v) [ "funclet"(token %cp) ]
+          to label %catch.cont unwind label %catch.cleanup
+catch.cont:
+  call void @dtor(ptr %e) [ "funclet"(token %cp) ]
+  catchret from %cp to label %done
+catch.cleanup:
+  %cl = cleanuppad within %cp []
+  call void @dtor(ptr %e) [ "funclet"(token %cl) ]
+  cleanupret from %cl unwind to caller
+done:
+  %r = phi i32 [ %u, %catch.cont ], [ 0, %entry ]
+  ret i32 %r
+}
+
+; A parent local read and written in the catch, with a frame pointer: the
+; funclet sets up its own r11, so the local must be reached through r6.
+define i32 @catch_parent_local(i32 %x) "frame-pointer"="all" personality ptr @__CxxFrameHandler3 {
+; CHECK-LABEL: catch_parent_local:
+; CHECK:       str r0, [r6, #[[#PL:]]]
+; CHECK-LABEL: "?catch$2@?0?catch_parent_local@4HA":
+; CHECK:       .seh_endprologue
+; CHECK-NOT:   {{\[(sp|r11)}}
+; CHECK:       ldr r0, [r6, #[[#PL]]]
+; CHECK-NOT:   {{\[(sp|r11)}}
+; CHECK:       str r0, [r6, #[[#PL]]]
+; CHECK-NOT:   {{\[(sp|r11)}}
+; CHECK:       movw r0
+entry:
+  %local = alloca i32, align 4
+  store volatile i32 %x, ptr %local, align 4
+  invoke void @g() to label %done unwind label %dispatch
+dispatch:
+  %cs = catchswitch within none [label %catch] unwind to caller
+catch:
+  %cp = catchpad within %cs [ptr null, i32 64, ptr null]
+  %v = load volatile i32, ptr %local, align 4
+  %w = add i32 %v, 1
+  store volatile i32 %w, ptr %local, align 4
+  catchret from %cp to label %done
+done:
+  %r = load volatile i32, ptr %local, align 4
+  ret i32 %r
+}
