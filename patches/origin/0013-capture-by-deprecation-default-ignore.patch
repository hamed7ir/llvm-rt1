+// RUN: %clang_cc1 -std=c++20 -fsyntax-only -Werror -verify=default %s
+// RUN: %clang_cc1 -std=c++20 -fsyntax-only -Wdeprecated-attributes -verify=enabled %s
+
+// The parenthesised lifetime_capture_by(this|global|unknown) spellings are
+// deprecated, but the warning is off by default: code written for compilers
+// that only know those spellings -- abseil's ABSL_INTERNAL_ATTRIBUTE_CAPTURED_BY
+// is the case that matters -- builds cleanly under -Werror.
+// -Wdeprecated-attributes still reports every one.
+
+// default-no-diagnostics
+
+#define ABSL_INTERNAL_ATTRIBUTE_CAPTURED_BY(Owner) [[clang::lifetime_capture_by(Owner)]]
+
+struct SpinLock {
+  void set(const int &v ABSL_INTERNAL_ATTRIBUTE_CAPTURED_BY(this)); // enabled-warning {{'lifetime_capture_by(this)' is deprecated; use 'lifetime_capture_by_this' instead}}
+};
+
+void to_global(const int &v [[clang::lifetime_capture_by(global)]]); // enabled-warning {{'lifetime_capture_by(global)' is deprecated; use 'lifetime_capture_by_global' instead}}
+void to_unknown(const int &v [[clang::lifetime_capture_by(unknown)]]); // enabled-warning {{'lifetime_capture_by(unknown)' is deprecated; use 'lifetime_capture_by_unknown' instead}}
+
+// The new spellings are silent either way.
+struct Modern {
+  void set(const int &v [[clang::lifetime_capture_by_this]]);
+};
