+// RUN: %clang_cc1 -ffreestanding -fms-extensions -fms-compatibility -fms-compatibility-version=19.00 \
+// RUN:         -triple thumbv7--windows -emit-llvm %s -o - \
+// RUN:         | FileCheck %s --implicit-check-not=@_AddressOfReturnAddress
+
+// _AddressOfReturnAddress on ARM: the address of the slot holding the return
+// address. intrin.h declares it for every architecture, but it was not an ARM
+// builtin, so the call compiled to an external reference that cannot link.
+// The backend half (ISD::ADDROFRETURNADDR, with the LR spill a leaf needs) is
+// tested in llvm/test/CodeGen/ARM/addressofreturnaddress.ll, which comes with
+// the patch that completes it (rt2.1 0020; one upstream change with this one).
+
+// intrin.h needs size_t, but -ffreestanding prevents us from getting it from
+// stddef.h.  Work around it with this typedef.
+typedef __SIZE_TYPE__ size_t;
+#include <intrin.h>
+
+void *test_AddressOfReturnAddress(void) { return _AddressOfReturnAddress(); }
+// CHECK-LABEL: define dso_local {{.*}}ptr @test_AddressOfReturnAddress()
+// CHECK: [[R:%.*]] = call ptr @llvm.addressofreturnaddress.p0()
+// CHECK: ret ptr [[R]]
