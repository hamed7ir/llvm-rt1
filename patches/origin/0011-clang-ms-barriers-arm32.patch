diff --git a/clang/test/Preprocessor/pragma_microsoft_arm.c b/clang/test/Preprocessor/pragma_microsoft_arm.c
--- /dev/null
+++ b/clang/test/Preprocessor/pragma_microsoft_arm.c
@@ -0,0 +1,11 @@
+// RUN: %clang_cc1 -triple thumbv7-windows-msvc %s -fsyntax-only -verify -fms-extensions
+
+// The Microsoft compiler barriers are builtins on 32-bit Arm, as they are on
+// x86 and AArch64, so '#pragma intrinsic' must accept them without a
+// -Wignored-pragma-intrinsic warning.
+
+// expected-no-diagnostics
+
+#pragma intrinsic(_ReadBarrier)
+#pragma intrinsic(_ReadWriteBarrier)
+#pragma intrinsic(_WriteBarrier)
