+frameInfo:
+  maxAlignment:    1
+machineFunctionInfo:
+  isLRSpilled:     false
+body:             |
+  bb.0 (%ir-block.2):
+    liveins: $r0, $r1
+
+    $d1_d2, $r0 = VLD1q16wb_fixed killed renamable $r0, 0, 14 /* CC::al */, $noreg, implicit-def $d1_d2_d3, debug-location !44 :: (load (s128) from %ir.0, align 2)
+    DBG_VALUE $d1_d2, $noreg, !38, !DIExpression(), debug-location !45
+    renamable $r0, dead $cpsr = tADDi8 killed renamable $r0, 8, 14 /* CC::al */, $noreg
+    $d3 = VLD1d16 killed renamable $r0, 0, 14 /* CC::al */, $noreg, implicit killed $d1_d2_d3, implicit-def $d1_d2_d3, debug-location !43 :: (load (s64) from %ir.3 + 8, align 2)
+    DBG_VALUE $q1, $noreg, !34, !DIExpression(), debug-location !46
+    VST1q16 killed $r1, 0, $q1, 14 /* CC::al */, $noreg, implicit killed $d1_d2_d3, debug-location !43 :: (store (s128) into %ir.1, align 2)
+    tBX_RET 14 /* CC::al */, $noreg, debug-location !47
