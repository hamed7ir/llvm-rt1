index 000000000..f854e7877
--- /dev/null
+++ b/llvm/test/DebugInfo/COFF/ARMNT/codeview-d-pair-register.mir
@@ -0,0 +1,141 @@
+# Check that a variable living in an ARM D-register pair does not abort CodeView
+# emission.  D-register pairs such as D1_D2 are RegisterTuples: the odd-even
+# pairs deliberately have no Q register covering them (see TuplesOE2D in
+# ARMRegisterInfo.td), and the CodeView format has no register number for a
+# D-pair at all -- it encodes only S0-S31, D0-D31 and Q0-Q15.  There is
+# therefore no correct value to emit for such a register, so the variable's
+# location is dropped and the variable reports as optimized out.  Emitting a
+# wrong register, or one half of the pair, would be worse than emitting nothing.
+#
+# Before this was handled, getCodeViewRegNum() reached a report_fatal_error and
+# the whole object file was lost: "error in backend: unknown codeview register
+# D1_D2".  See https://github.com/llvm/llvm-project/issues/64278.
+#
+# The two variables here differ in exactly one respect -- whether their register
+# is representable in CodeView -- so 'qreg' doubles as the control: it must keep
+# a real def range, proving the fallible lookup did not disturb mappable
+# registers.
+#
+# RUN: llc %s -mtriple=thumbv7-unknown-windows-msvc -filetype=obj -o %t --start-after=unpack-mi-bundles
+# RUN: llvm-readobj --codeview %t | FileCheck %s --check-prefix=KEPT
+# RUN: llvm-readobj --codeview %t | FileCheck %s --check-prefix=DROPPED
+# RUN: llvm-readobj --codeview %t | FileCheck %s --check-prefix=NOPAIR
+#
+# A Q register is mappable, so this variable keeps its location:
+#      KEPT:   VarName: qreg
+# KEPT-NEXT: }
+# KEPT-NEXT: DefRangeRegisterSym {
+# KEPT-NEXT:   Kind: S_DEFRANGE_REGISTER (0x1141)
+# KEPT-NEXT:   Register: ARM_NQ1 (0x191)
+#
+# The D-pair variable survives with its name and type, but no location:
+#      DROPPED:   Flags [ (0x100)
+# DROPPED-NEXT:     IsOptimizedOut (0x100)
+# DROPPED-NEXT:   ]
+# DROPPED-NEXT:   VarName: dpair
+#
+# Nothing may name the tuple, nor silently substitute one half of it -- that
+# would put the debugger's idea of the variable in the wrong place, which is
+# worse than having no location at all.  No other variable here uses D1 or D2,
+# so neither name can appear for any legitimate reason.
+# NOPAIR-NOT: D1_D2
+# NOPAIR-NOT: ARM_ND1 (
+# NOPAIR-NOT: ARM_ND2 (
+--- |
+  ; ModuleID = 'test.c'
+  source_filename = "test.c"
+  target datalayout = "e-m:w-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64"
+  target triple = "thumbv7-unknown-windows-msvc19.33.0"
+
+  ; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(argmem: readwrite) uwtable
+  define dso_local arm_aapcs_vfpcc void @f(ptr nocapture noundef readonly %0, ptr noundef %1) local_unnamed_addr #0 !dbg !25 {
+    %3 = getelementptr inbounds i16, ptr %0, i32 8, !dbg !41
+    %4 = load <8 x i16>, ptr %3, align 2, !dbg !41
+    %5 = shufflevector <8 x i16> %4, <8 x i16> poison, <4 x i32> <i32 4, i32 5, i32 6, i32 7>, !dbg !43
+    %6 = load <8 x i16>, ptr %0, align 2, !dbg !44
+    %7 = shufflevector <8 x i16> %6, <8 x i16> poison, <4 x i32> <i32 4, i32 5, i32 6, i32 7>, !dbg !43
+    %8 = shufflevector <4 x i16> %7, <4 x i16> %5, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>, !dbg !43
+    tail call void @llvm.arm.neon.vst1.p0.v8i16(ptr %1, <8 x i16> %8, i32 2), !dbg !43
+    ret void, !dbg !47
+  }
+
+  ; Function Attrs: mustprogress nocallback nofree nosync nounwind willreturn memory(argmem: readwrite)
+  declare void @llvm.arm.neon.vst1.p0.v8i16(ptr, <8 x i16>, i32) #1
+
+  ; Function Attrs: mustprogress nocallback nofree nosync nounwind speculatable willreturn memory(none)
+  declare void @llvm.dbg.value(metadata, metadata, metadata) #2
+
+  attributes #0 = { mustprogress nofree norecurse nosync nounwind willreturn memory(argmem: readwrite) uwtable "frame-pointer"="all" "no-trapping-math"="true" "stack-protector-buffer-size"="8" "target-cpu"="cortex-a9" "target-features"="+armv7-a,+d32,+dsp,+fp16,+fp64,+neon,+thumb-mode,+vfp2,+vfp2sp,+vfp3,+vfp3d16,+vfp3d16sp,+vfp3sp,-aes,-fp-armv8,-fp-armv8d16,-fp-armv8d16sp,-fp-armv8sp,-fp16fml,-fullfp16,-sha2,-vfp4,-vfp4d16,-vfp4d16sp,-vfp4sp" }
+  attributes #1 = { mustprogress nocallback nofree nosync nounwind willreturn memory(argmem: readwrite) }
+  attributes #2 = { mustprogress nocallback nofree nosync nounwind speculatable willreturn memory(none) }
+
+  !llvm.dbg.cu = !{!0}
+  !llvm.module.flags = !{!17, !18, !19, !20, !21, !22, !23}
+
+  !0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, producer: "clang", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug, retainedTypes: !2, splitDebugInlining: false, nameTableKind: None)
+  !1 = !DIFile(filename: "test.c", directory: ".")
+  !2 = !{!3, !11}
+  !3 = !DIDerivedType(tag: DW_TAG_typedef, name: "int16x8_t", file: !4, line: 26, baseType: !5)
+  !4 = !DIFile(filename: "arm_vector_types.h", directory: ".")
+  !5 = !DICompositeType(tag: DW_TAG_array_type, baseType: !6, size: 128, flags: DIFlagVector, elements: !9)
+  !6 = !DIDerivedType(tag: DW_TAG_typedef, name: "int16_t", file: !7, line: 19, baseType: !8)
+  !7 = !DIFile(filename: "stdint.h", directory: ".")
+  !8 = !DIBasicType(name: "short", size: 16, encoding: DW_ATE_signed)
+  !9 = !{!10}
+  !10 = !DISubrange(count: 8)
+  !11 = !DIDerivedType(tag: DW_TAG_typedef, name: "int8x16_t", file: !4, line: 24, baseType: !12)
+  !12 = !DICompositeType(tag: DW_TAG_array_type, baseType: !13, size: 128, flags: DIFlagVector, elements: !15)
+  !13 = !DIDerivedType(tag: DW_TAG_typedef, name: "int8_t", file: !7, line: 18, baseType: !14)
+  !14 = !DIBasicType(name: "signed char", size: 8, encoding: DW_ATE_signed_char)
+  !15 = !{!16}
+  !16 = !DISubrange(count: 16)
+  !17 = !{i32 2, !"CodeView", i32 1}
+  !18 = !{i32 2, !"Debug Info Version", i32 3}
+  !19 = !{i32 1, !"wchar_size", i32 2}
+  !20 = !{i32 1, !"min_enum_size", i32 4}
+  !21 = !{i32 7, !"uwtable", i32 2}
+  !22 = !{i32 7, !"frame-pointer", i32 2}
+  !23 = !{i32 7, !"debug-info-assignment-tracking", i1 true}
+  !25 = distinct !DISubprogram(name: "f", scope: !1, file: !1, line: 2, type: !26, scopeLine: 2, flags: DIFlagPrototyped, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !31)
+  !26 = !DISubroutineType(types: !27)
+  !27 = !{null, !28, !30}
+  !28 = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: !29, size: 32)
+  !29 = !DIDerivedType(tag: DW_TAG_const_type, baseType: !8)
+  !30 = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: !8, size: 32)
+  !31 = !{!34, !38}
+  !34 = !DILocalVariable(name: "qreg", scope: !35, file: !1, line: 3, type: !3)
+  !35 = distinct !DILexicalBlock(scope: !25, file: !1, line: 3)
+  !38 = !DILocalVariable(name: "dpair", scope: !39, file: !1, line: 3, type: !3)
+  !39 = distinct !DILexicalBlock(scope: !35, file: !1, line: 3)
+  !41 = !DILocation(line: 3, scope: !39)
+  !43 = !DILocation(line: 3, scope: !35)
+  !44 = !DILocation(line: 3, scope: !39)
+  !45 = !DILocation(line: 0, scope: !39)
+  !46 = !DILocation(line: 0, scope: !35)
+  !47 = !DILocation(line: 5, scope: !25)
