+MCRegisterInfo::getCodeViewRegNumOrNone(MCRegister RegNum) const {
+  // A target with no mapping at all has not implemented CodeView support; that
+  // is a target configuration error rather than a gap in a mapping, so it stays
+  // fatal here as well.  Downgrading it would silently strip the locations of
+  // every variable in the module.
   if (L2CVRegs.empty())
     report_fatal_error("target does not implement codeview register mapping");
   const DenseMap<MCRegister, int>::const_iterator I = L2CVRegs.find(RegNum);
   if (I == L2CVRegs.end())
-    report_fatal_error("unknown codeview register " + (RegNum < getNumRegs()
-                                                           ? getName(RegNum)
-                                                           : Twine(RegNum)));
+    return std::nullopt;
   return I->second;
 }
 
+int MCRegisterInfo::getCodeViewRegNum(MCRegister RegNum) const {
+  if (std::optional<int> CVRegNum = getCodeViewRegNumOrNone(RegNum))
+    return *CVRegNum;
+  report_fatal_error("unknown codeview register " + (RegNum < getNumRegs()
+                                                         ? getName(RegNum)
+                                                         : Twine(RegNum)));
+}
